      "columns": {
        "order_id": { "description": "Primary key", "ar": ["رقم الطلب", "معرف الطلب"], "ur": ["آرڈر نمبر", "آرڈر آئی ڈی"] },
        "customer_id": { "description": "Which customer placed it", "ar": ["رقم العميل"], "ur": ["کسٹمر آئی ڈی"] },
