        "name_en": { "description": "Customer name in English", "ar": ["اسم العميل"], "ur": ["کسٹمر کا نام"] },
        "name_ar": { "description": "Customer name in Arabic", "ar": ["الاسم بالعربية"], "ur": ["عربی نام"] },
        "city": { "description": "City the customer is based in", "ar": ["المدينة", "مدينة"], "ur": ["شہر"] },
        "country": { "description": "Country the customer is based in", "ar": ["الدولة", "البلد"], "ur": ["ملک"] },
        "segment": { "description": "Commercial segment", "ar": ["الشريحة", "الفئة"], "ur": ["سیگمنٹ", "طبقہ"] },
        "signed_up_on": { "description": "Date the account was created (YYYY-MM-DD)", "ar": ["تاريخ التسجيل", "تاريخ الاشتراك"], "ur": ["سائن اپ کی تاریخ", "رجسٹریشن کی تاریخ"] }
      }
    },
    "orders": {
