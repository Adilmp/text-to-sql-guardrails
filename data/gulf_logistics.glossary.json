        "placed_at": { "description": "When the order was placed (YYYY-MM-DD HH:MM:SS)", "ar": ["تاريخ الطلب", "وقت الطلب"], "ur": ["آرڈر کی تاریخ", "آرڈر دینے کا وقت"] },
        "promised_at": { "description": "Delivery date promised to the customer", "ar": ["التاريخ الموعود", "موعد التسليم"], "ur": ["وعدہ شدہ تاریخ", "ڈیلیوری کی مقررہ تاریخ"] },
        "delivered_at": { "description": "Actual delivery timestamp, NULL if not yet delivered", "ar": ["تاريخ التسليم", "وقت التسليم الفعلي"], "ur": ["ڈیلیوری کی تاریخ", "ڈیلیور ہونے کا وقت"] },
        "status": { "description": "Lifecycle state", "ar": ["الحالة", "حالة الطلب"], "ur": ["اسٹیٹس", "حالت"] },
        "total_aed": { "description": "Order total in AED", "ar": ["الإجمالي", "المبلغ", "القيمة", "درهم"], "ur": ["کل رقم", "مالیت", "درہم"] }
