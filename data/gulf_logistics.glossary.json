{
  "_comment": "Curated multilingual metadata layered on top of SQLite introspection. Arabic (ar) and Urdu (ur) aliases are matched after normalize_for_matching(), so diacritics, letter variants and Urdu/Arabic keyboard differences do not need to be enumerated here. Keep column keys exactly as spelled in the database.",
  "definitions": [
    { "term": "revenue / sales", "ar": ["الإيرادات", "المبيعات"], "ur": ["آمدنی", "سیلز", "فروخت"], "sql": "SUM(order_items.quantity * order_items.unit_price_aed)", "note": "the price actually charged on each line; products.unit_price_aed is the catalogue list price, used only when the question asks about the catalogue or list price" },
    { "term": "order value / order total", "ar": ["قيمة الطلب"], "ur": ["آرڈر کی مالیت", "آرڈر کی رقم"], "sql": "orders.total_aed", "note": "already equals the sum of the order's lines" },
    { "term": "late order", "ar": ["طلب متأخر", "تأخر"], "ur": ["تاخیر"], "sql": "orders.delivered_at IS NOT NULL AND orders.delivered_at > orders.promised_at", "note": "an order that has not been delivered is neither late nor on time" },
    { "term": "delivered order", "ar": ["طلب مسلّم"], "ur": ["ڈیلیور شدہ آرڈر"], "sql": "orders.delivered_at IS NOT NULL", "note": "returned orders have no delivered_at" }
  ],
  "tables": {
