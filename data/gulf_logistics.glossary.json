        "category": { "description": "Product category", "ar": ["الفئة", "التصنيف"], "ur": ["کیٹیگری", "زمرہ"] },
        "unit_price_aed": { "description": "Catalogue list price in AED, before any discount", "ar": ["سعر القائمة", "السعر"], "ur": ["کیٹلاگ قیمت", "لسٹ قیمت"] },
