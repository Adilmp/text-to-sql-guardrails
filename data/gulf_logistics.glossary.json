        "product_id": { "description": "Which product", "ar": ["رقم المنتج"], "ur": ["پروڈکٹ آئی ڈی"] },
        "quantity": { "description": "Units ordered", "ar": ["الكمية", "العدد"], "ur": ["مقدار", "یونٹس"] },
        "unit_price_aed": { "description": "Price actually charged per unit, after discount", "ar": ["سعر الوحدة", "السعر المدفوع"], "ur": ["وصول شدہ قیمت", "اصل قیمت"] }
      }
    },
    "products": {
      "description": "Product catalogue",
      "ar": ["المنتجات", "السلع", "منتج"],
