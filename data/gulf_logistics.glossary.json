        "name_ar": { "description": "Warehouse name in Arabic", "ar": ["الاسم بالعربية"], "ur": ["عربی نام"] },
        "city": { "description": "City", "ar": ["المدينة"], "ur": ["شہر"] },
        "country": { "description": "Country", "ar": ["الدولة"], "ur": ["ملک"] },
        "capacity_m3": { "description": "Storage capacity in cubic metres", "ar": ["السعة", "الطاقة الاستيعابية"], "ur": ["گنجائش"] }
      }
    },
    "couriers": {
      "description": "Delivery companies",
      "ar": ["شركات التوصيل", "الناقلون", "الناقل", "شركة الشحن"],
      "ur": ["کورئیرز", "کورئیر", "ڈیلیوری کمپنیاں"],
      "columns": {
        "courier_id": { "description": "Primary key", "ar": ["رقم الناقل"], "ur": ["کورئیر آئی ڈی"] },
        "name_en": { "description": "Courier name in English", "ar": ["اسم الناقل"], "ur": ["کورئیر کا نام"] },
        "name_ar": { "description": "Courier name in Arabic", "ar": ["الاسم بالعربية"], "ur": ["عربی نام"] },
        "country": { "description": "Country of operation", "ar": ["الدولة"], "ur": ["ملک"] },
        "is_active": { "description": "1 if currently used, 0 if retired", "ar": ["نشط", "فعال"], "ur": ["فعال", "ایکٹو"] }
      }
